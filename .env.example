# .env.example - Variables de Entorno Requeridas

# No compartir este archivo con APIs activas
# Usar como referencia para configurar tu ambiente local

# ===== GOOGLE APIs =====
# Obtener en: https://console.cloud.google.com/
GOOGLE_API_KEY=tu_clave_aqui
GOOGLE_SEARCH_ENGINE_ID=tu_id_aqui
GOOGLE_GEMINI_API_KEY=tu_api_key_aqui

# ===== BASE DE DATOS =====
# Usar cuando se implemente persistencia
DATABASE_URL=tu_url_base_datos_aqui
DATABASE_USER=usuario
DATABASE_PASSWORD=contraseña

# ===== AUTENTICACIÓN =====
# Usar cuando se implemente login
JWT_SECRET=tu_jwt_secret_aqui
SESSION_SECRET=tu_session_secret_aqui

# ===== PRODUCCIÓN =====
# Configuración del servidor
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ===== LOGGING =====
# Nivel de detalle en logs
LOG_LEVEL=info
